# Template only. Copy to .env locally; never commit real API keys.
FIREWORKS_API_KEY=
# Set the exact chat model ID that works in your Fireworks account.
FIREWORKS_MODEL=
FIREWORKS_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

PINECONE_API_KEY=
PINECONE_INDEX=luma-learning
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional: traces may contain questions, passages, and answers.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=luma-learning
LANGSMITH_WORKSPACE_ID=
RETRIEVAL_MIN_SCORE=0.45
